# Modelo do `.env` de produção. COPIE para `.env` e preencha.
# `.env` não é versionado (ver .gitignore) — ele tem as senhas do banco e do
# painel.

# O domínio que o Traefik serve. Sem ele, o compose recusa subir.
DOMINIO=

# A ALLOWLIST DO PAINEL, em CIDR separado por vírgula.
#
# Vazia ou ausente, o compose cai no padrão FECHADO (`127.0.0.1/32`) — e isso
# é deliberado: um painel aberto por omissão é o pior modo de falha possível.
# Ver infra/producao/README.md e o comentário no docker-compose.yml.
IPS_DO_PAINEL=

SENHA_POSTGRES=
SENHA_MIGRATE=
SENHA_APP=
SENHA_REDIS=

# Preenchidas por `./provisionar-painel.sh`. Não escreva à mão.
# SENHA_PAINEL=
# DATABASE_URL_PAINEL=

VERSAO=mais-recente
